{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "id",
      "name",
      "url",
      "category",
      "archetype",
      "inspected_on",
      "summary",
      "yc_status",
      "batch",
      "verification_url",
      "geography_evidence",
      "coverage",
      "viewports",
      "observations",
      "interpretation",
      "limitations",
      "sources"
    ],
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "url": {
        "type": "string",
        "minLength": 1
      },
      "category": {
        "type": "string",
        "minLength": 1
      },
      "archetype": {
        "type": "string",
        "minLength": 1
      },
      "inspected_on": {
        "type": "string",
        "minLength": 1
      },
      "summary": {
        "type": "string",
        "minLength": 1
      },
      "yc_status": {
        "enum": [
          "verified-yc",
          "not-verified"
        ]
      },
      "batch": {
        "type": [
          "string",
          "null"
        ]
      },
      "verification_url": {
        "type": [
          "string",
          "null"
        ]
      },
      "geography_evidence": {
        "type": [
          "string",
          "null"
        ]
      },
      "coverage": {
        "enum": [
          "desktop-mobile-audit",
          "desktop-audit",
          "partial-desktop"
        ]
      },
      "viewports": {
        "type": "object",
        "required": [
          "desktop",
          "tablet",
          "mobile"
        ],
        "additionalProperties": false,
        "properties": {
          "desktop": {
            "type": "string",
            "minLength": 1
          },
          "tablet": {
            "type": "string",
            "minLength": 1
          },
          "mobile": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "observations": {
        "type": "object",
        "required": [
          "hero",
          "typography",
          "visual_system",
          "page_sequence",
          "interaction",
          "accessibility"
        ],
        "additionalProperties": false,
        "properties": {
          "hero": {
            "type": "string",
            "minLength": 1
          },
          "typography": {
            "type": "string",
            "minLength": 1
          },
          "visual_system": {
            "type": "string",
            "minLength": 1
          },
          "page_sequence": {
            "type": "string",
            "minLength": 1
          },
          "interaction": {
            "type": "string",
            "minLength": 1
          },
          "accessibility": {
            "type": "string",
            "minLength": 1
          },
          "mobile": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "interpretation": {
        "type": "object",
        "required": [
          "principles",
          "fit",
          "risks"
        ],
        "additionalProperties": false,
        "properties": {
          "principles": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "fit": {
            "type": "string",
            "minLength": 1
          },
          "risks": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "limitations": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "sources": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "pattern": "^https?://"
        }
      },
      "measurements": {
        "type": "object",
        "description": "Computed-style measurements from scripts/measure.mjs. Numbers only; families are the first family in each computed font stack, not verified font identities. Animation counts are animations running at that moment, not a full motion inventory.",
        "required": [
          "measured_on",
          "desktop"
        ],
        "additionalProperties": false,
        "properties": {
          "measured_on": {
            "type": "string"
          },
          "desktop": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "width",
              "h1_px",
              "body_px",
              "section_count",
              "horizontal_overflow",
              "reduced_motion_rule"
            ],
            "properties": {
              "width": {
                "type": "integer"
              },
              "h1_px": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "h1_weight": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "h1_tracking_em": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "h1_line_height": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "h1_family": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "display_px": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "body_px": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "body_line_height": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "body_measure_ch": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "families": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "content_width_px": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "nav_height_px": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "sticky_nav": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "hero_height_px": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "section_count": {
                "type": "integer"
              },
              "page_height_px": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "horizontal_overflow": {
                "type": "boolean"
              },
              "reduced_motion_rule": {
                "enum": [
                  "observed",
                  "not_observed",
                  "unverified"
                ]
              },
              "animations_on_load": {
                "type": "integer"
              },
              "animations_after_scroll": {
                "type": "integer"
              },
              "has_video": {
                "type": "boolean"
              },
              "has_canvas": {
                "type": "boolean"
              },
              "dark_background": {
                "type": "boolean"
              }
            }
          },
          "mobile": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "width",
              "h1_px",
              "body_px",
              "section_count",
              "horizontal_overflow",
              "reduced_motion_rule"
            ],
            "properties": {
              "width": {
                "type": "integer"
              },
              "h1_px": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "h1_weight": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "h1_tracking_em": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "h1_line_height": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "h1_family": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "display_px": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "body_px": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "body_line_height": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "body_measure_ch": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "families": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "content_width_px": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "nav_height_px": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "sticky_nav": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "hero_height_px": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "section_count": {
                "type": "integer"
              },
              "page_height_px": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "horizontal_overflow": {
                "type": "boolean"
              },
              "reduced_motion_rule": {
                "enum": [
                  "observed",
                  "not_observed",
                  "unverified"
                ]
              },
              "animations_on_load": {
                "type": "integer"
              },
              "animations_after_scroll": {
                "type": "integer"
              },
              "has_video": {
                "type": "boolean"
              },
              "has_canvas": {
                "type": "boolean"
              },
              "dark_background": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "program": {
        "enum": [
          "yc",
          "a16z-speedrun",
          "a16z",
          "pear"
        ]
      },
      "round": {
        "type": [
          "string",
          "null"
        ]
      },
      "archetype_note": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "yc_status": {
              "const": "verified-yc"
            }
          }
        },
        "then": {
          "properties": {
            "verification_url": {
              "type": "string",
              "pattern": "^https://www\\.ycombinator\\.com/companies/[a-z0-9-]+$"
            },
            "batch": {
              "type": "string",
              "pattern": "^[WSPFX][0-9]{2}$"
            }
          }
        }
      }
    ]
  }
}
