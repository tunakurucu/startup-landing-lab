{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "id",
      "name",
      "website",
      "category",
      "archetype",
      "archetype_status",
      "reason",
      "verified_on",
      "yc_status",
      "batch",
      "verification_url",
      "audit_id",
      "geography_evidence"
    ],
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "website": {
        "type": "string",
        "minLength": 1
      },
      "category": {
        "type": "string",
        "minLength": 1
      },
      "archetype": {
        "type": "string",
        "minLength": 1
      },
      "archetype_status": {
        "type": "string",
        "minLength": 1
      },
      "reason": {
        "type": "string",
        "minLength": 1
      },
      "verified_on": {
        "type": "string",
        "minLength": 1
      },
      "yc_status": {
        "enum": [
          "verified-yc",
          "not-verified"
        ]
      },
      "batch": {
        "type": [
          "string",
          "null"
        ]
      },
      "location": {
        "type": [
          "string",
          "null"
        ]
      },
      "verification_url": {
        "type": [
          "string",
          "null"
        ]
      },
      "audit_id": {
        "type": [
          "string",
          "null"
        ]
      },
      "geography_evidence": {
        "type": [
          "string",
          "null"
        ]
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "ycdc_status": {
        "type": [
          "string",
          "null"
        ]
      },
      "city": {
        "type": [
          "string",
          "null"
        ]
      },
      "country": {
        "type": [
          "string",
          "null"
        ]
      },
      "program": {
        "enum": [
          "yc",
          "a16z-speedrun",
          "a16z",
          "pear",
          "sequoia-arc",
          "neo",
          "ef"
        ],
        "description": "Which accelerator or fund page verified this company. yc_status stays the YC-specific field."
      },
      "round": {
        "type": [
          "string",
          "null"
        ],
        "description": "Non-YC cohort or round as stated on the verifying page, e.g. 'a16z speedrun SR006' or 'Seed 2026'."
      },
      "one_line": {
        "type": [
          "string",
          "null"
        ]
      },
      "selection_signal": {
        "type": [
          "string",
          "null"
        ],
        "description": "URL of third-party design praise, if any. A selection lead, not evidence."
      },
      "tier": {
        "enum": [
          "reference"
        ],
        "description": "Reference tier: recognised for design quality, audited as a benchmark rather than as a cohort sample."
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "yc_status": {
              "const": "verified-yc"
            }
          }
        },
        "then": {
          "properties": {
            "verification_url": {
              "type": "string",
              "pattern": "^https://www\\.ycombinator\\.com/companies/[a-z0-9-]+$"
            },
            "batch": {
              "type": "string",
              "pattern": "^[WSPFX][0-9]{2}$"
            }
          }
        }
      }
    ]
  }
}
