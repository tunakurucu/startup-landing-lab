{
  "name": "startup-landing-lab",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite gallery --host 0.0.0.0",
    "build": "tsc --noEmit && vite build gallery --base=/startup-landing-lab/",
    "typecheck": "tsc --noEmit",
    "lint": "eslint gallery/src",
    "validate": "python3 scripts/validate.py",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "eslint": "10.13.0",
    "typescript-eslint": "8.71.2",
    "@eslint/js": "10.0.1",
    "globals": "16.5.0",
    "@playwright/test": "1.56.1",
    "@axe-core/playwright": "4.10.2"
  }
}
