+}
+.composer-foot { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1rem; }
+.composer-foot .hint { margin: 0; font-size: var(--fs-meta); color: var(--ink-2); }
+.so-far { border-top: 1px solid var(--rule); padding: 0.75rem 1.125rem 0.25rem; }
+.so-far h4 { margin: 0 0 0.5rem; font: 600 var(--fs-meta)/1 var(--mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-2); }
+.so-far ol { list-style: none; margin: 0; padding: 0; }
+.so-far li { display: grid; grid-template-columns: auto 1fr; gap: 0.25rem 0.75rem; align-items: start; padding: 0.5rem 0; border-top: 1px solid var(--rule-soft); font-size: var(--fs-small); }
+.so-far li:first-child { border-top: 0; }
