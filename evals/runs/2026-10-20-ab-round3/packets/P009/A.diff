+.stays-out p + p { margin-top: 0.75rem; }
+
+/* Final action */
+.closing { padding: var(--section) 0; }
+.closing-inner { max-width: 40rem; }
+.closing h2 { margin-bottom: var(--s2); }
+.closing p { color: var(--ink-2); font-size: 1.125rem; }
+.closing .action-row { margin-top: var(--s3); }
 
