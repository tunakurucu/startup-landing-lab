+.week th:first-child { padding-left: 1.125rem; }
+.week .when { font-family: var(--mono); font-size: var(--fs-meta); color: var(--ink-2); white-space: nowrap; }
+.week .st { display: inline-flex; align-items: center; gap: 0.5rem; white-space: nowrap; font-weight: 600; }
+.week .st::before { content: ""; width: 10px; height: 10px; border-radius: 50%; background: var(--rule); flex: none; }
+.week .st-open::before { background: var(--coral); }
