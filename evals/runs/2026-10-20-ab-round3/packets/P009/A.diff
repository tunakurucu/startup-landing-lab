+/* Composer (step 1) */
+.composer { border: 1.5px solid var(--ink); border-radius: 4px; background: var(--ground); }
+.composer-head { padding: 0.75rem 1.125rem; border-bottom: 1.5px dashed var(--ink); display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.25rem 1rem; align-items: baseline; }
