+.so-far .empty { color: var(--ink-3); font-size: var(--fs-small); padding: 0.25rem 0 0.5rem; margin: 0; }
+
+/* Opening view (step 2) */
+.opening { border: 1.5px solid var(--ink); border-radius: 4px; max-width: 30rem; }
+.opening-head { padding: 0.875rem 1.125rem; border-bottom: 1.5px dashed var(--ink); }
+.opening-head .greet { font-family: var(--display); font-weight: 700; font-size: 1.25rem; display: block; }
+.opening ul { list-style: none; margin: 0; padding: 0; }
+.opening li { padding: 0.75rem 1.125rem; border-bottom: 1px solid var(--rule); display: grid; grid-template-columns: auto 1fr; gap: 0.25rem 0.75rem; align-items: baseline; font-size: 1rem; }
+.opening li:last-child { border-bottom: 0; }
+.opening li .from { grid-column: 2; font-family: var(--mono); font-size: var(--fs-meta); color: var(--ink-2); }
+.opening .read { background: var(--panel); color: var(--ink-2); font-size: var(--fs-small); }
+.opening .count { display: inline-flex; align-items: center; gap: 0.5rem; margin-top: 0.25rem; font-size: var(--fs-small); color: var(--ink-2); }
+.opening .count::before { content: ""; width: 10px; height: 10px; border-radius: 50%; background: var(--coral); }
+
+/* Week view (step 3): the owner's laptop reading. */
+.week { border: 1.5px solid var(--ink); border-radius: 4px; overflow: hidden; }
+.week-head { padding: 0.875rem 1.125rem; border-bottom: 1.5px dashed var(--ink); display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.25rem 1rem; align-items: baseline; }
+.week-head b { font-family: var(--display); font-size: 1.25rem; }
