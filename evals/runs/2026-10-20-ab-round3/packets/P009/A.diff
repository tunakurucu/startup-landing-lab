+  min-height: 40px; padding: 0 0.875rem;
+  border: 1.5px solid var(--rule); border-radius: 999px;
+  background: transparent; color: var(--ink);
+  font: 600 var(--fs-small)/1 var(--text); cursor: pointer;
+  transition: background-color 160ms var(--ease-out), border-color 160ms var(--ease-out);
+}
+.chip[aria-pressed="true"] { background: var(--ink); border-color: var(--ink); color: #fff; }
